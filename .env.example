# ---------------------------------------------------------------
# Maya Memories — variáveis de ambiente (NUNCA commitar valores reais)
# ---------------------------------------------------------------

# Público (vai para o navegador). A anon key é protegida por RLS.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# URL canônica do site (usada nos links mágicos e no NFC)
NEXT_PUBLIC_SITE_URL=https://maya.exemplo.com.br
# Maior arquivo que o Supabase Storage aceita, em MB (plano Free = 50; no Pro dá para subir em Storage → Settings).
# Vídeos acima disso são reduzidos no próprio celular antes do envio.
NEXT_PUBLIC_UPLOAD_MAX_MB=50

# Somente servidor. Usada apenas por rotas de automação (n8n) e scripts.
# Nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Primeiro acesso pelo site: e-mail(s) que viram administrador enquanto NÃO
# houver nenhum admin. Depois disso a regra desliga sozinha.
ADMIN_BOOTSTRAP_EMAILS=voce@email.com

# Segredo compartilhado com o n8n (Bearer). Gere com: openssl rand -hex 32
AUTOMATION_WEBHOOK_SECRET=

# Somente para scripts locais de backup/restauração (connection string Postgres)
SUPABASE_DB_URL=

# IA para o livro/filme (escolha das memórias e textos). Opcional: sem ela,
# o livro e o filme saem com textos-modelo e escolha automática simples.
ANTHROPIC_API_KEY=
